# contained in the NHANES blood pressure questionnaire.

data.frame(
  variable = names(nhanes$BPQ_L),
  label = sapply(nhanes$BPQ_L, function(x) attr(x, "label"))
)


# Add antihypertensive medication use to the analytic dataset
adult_data <- adult_data %>%
  left_join(
    nhanes$BPQ_L %>% select(SEQN, BPQ150),
    by = "SEQN"
  )

# Check the variable
table(adult_data$BPQ150, useNA = "ifany")

attr(adult_data$BPQ150, "label")


# ---------------------------------------------------------
# Inspect Antihypertensive Medication Coding
# ---------------------------------------------------------

# Compare BPQ150 with the preceding hypertension questions
# to understand its skip pattern and coding.

table(adult_data$BPQ150, useNA = "ifany")

table(
  adult_data$BPQ020,
  adult_data$BPQ150,
  useNA = "ifany"
)

# ---------------------------------------------------------
# Recode Antihypertensive Medication Use
# ---------------------------------------------------------

# BPQ150:
# 1 = Yes
# 2 = No
# 7 = Refused
# 9 = Don't know
#
# BPQ150 is only asked of participants who reported having
# been told that they had high blood pressure.
#
# Participants who answered "No" to BPQ020 therefore have
# structural missing values for BPQ150.

adult_data <- adult_data %>%
  mutate(
    bp_medication = case_when(
      BPQ150 == 1 ~ 1,                 # Currently taking BP medication
      BPQ150 == 2 ~ 0,                 # Not taking BP medication
      BPQ020 == 2 ~ 0,                 # Never diagnosed; BPQ150 skipped
      TRUE ~ NA_real_                  # Refused, don't know, or other missing
    )
  )

# Check the new variable
table(adult_data$bp_medication, useNA = "ifany")

# ---------------------------------------------------------
# Define Hypertension Outcome
# ---------------------------------------------------------

# Hypertension is defined as:
#   - Mean systolic blood pressure >= 130 mmHg, OR
#   - Mean diastolic blood pressure >= 80 mmHg, OR
#   - Current use of antihypertensive medication.
#
# Participants without BP measurements can still be classified
# as hypertensive if they report taking BP medication.
# Otherwise, participants without sufficient information remain NA.

adult_data <- adult_data %>%
  mutate(
    hypertension = case_when(
      mean_sbp >= 130 ~ 1,
      mean_dbp >= 80 ~ 1,
      bp_medication == 1 ~ 1,
      
      !is.na(mean_sbp) & !is.na(mean_dbp) &
        bp_medication == 0 ~ 0,
      
      TRUE ~ NA_real_
    )
  )

# Examine the hypertension outcome
table(adult_data$hypertension, useNA = "ifany")

prop.table(
  table(adult_data$hypertension)
) * 100




# ---------------------------------------------------------
# NHANES Complex Survey Design
# ---------------------------------------------------------
install.packages("minqa", type = "binary")
install.packages("survey", type = "binary")

library(survey)

# NHANES uses a complex, multistage probability sampling design.
# MEC examination weights, strata, and PSU variables are used
# to obtain nationally representative estimates.

nhanes_design <- svydesign(
  ids = ~SDMVPSU,
  strata = ~SDMVSTRA,
  weights = ~WTMEC2YR,
  nest = TRUE,
  data = adult_data
)

# Estimate survey-weighted hypertension prevalence
svymean(
  ~hypertension,
  design = subset(nhanes_design, !is.na(hypertension)),
  na.rm = TRUE
)

# ---------------------------------------------------------
# Survey-Weighted Hypertension Prevalence
# ---------------------------------------------------------

# Estimate nationally representative hypertension prevalence
htn_prevalence <- svymean(
  ~hypertension,
  design = subset(nhanes_design, !is.na(hypertension)),
  na.rm = TRUE
)

# Display prevalence estimate
htn_prevalence

# Calculate 95% confidence interval
confint(htn_prevalence)



# ---------------------------------------------------------
# Create Demographic Variables
# ---------------------------------------------------------

adult_data <- adult_data %>%
  mutate(
    
    # Sex
    sex = case_when(
      RIAGENDR == 1 ~ "Male",
      RIAGENDR == 2 ~ "Female",
      TRUE ~ NA_character_
    ),
    
    # Age groups
    age_group = case_when(
      RIDAGEYR >= 20 & RIDAGEYR <= 39 ~ "20-39",
      RIDAGEYR >= 40 & RIDAGEYR <= 59 ~ "40-59",
      RIDAGEYR >= 60 ~ "60+",
      TRUE ~ NA_character_
    )
  )

# ---------------------------------------------------------
# Recode Clinical and Behavioral Risk Factors
# ---------------------------------------------------------

adult_data <- adult_data %>%
  mutate(
    
    # BMI category based on measured BMI (kg/m^2)
    bmi_category = case_when(
      BMXBMI < 18.5 ~ "Underweight",
      BMXBMI >= 18.5 & BMXBMI < 25 ~ "Normal weight",
      BMXBMI >= 25 & BMXBMI < 30 ~ "Overweight",
      BMXBMI >= 30 ~ "Obesity",
      TRUE ~ NA_character_
    ),
    
    # Diabetes status
    # DIQ010: 1 = Yes, 2 = No, 3 = Borderline
    diabetes = case_when(
      DIQ010 == 1 ~ "Yes",
      DIQ010 %in% c(2, 3) ~ "No",
      TRUE ~ NA_character_
    ),
    
    # Smoking status
    # Never smoker: has not smoked 100 cigarettes in lifetime
    # Former smoker: smoked 100+ cigarettes but does not currently smoke
    # Current smoker: currently smokes every day or some days
    smoking_status = case_when(
      SMQ020 == 2 ~ "Never",
      SMQ020 == 1 & SMQ040 == 3 ~ "Former",
      SMQ020 == 1 & SMQ040 %in% c(1, 2) ~ "Current",
      TRUE ~ NA_character_
    )
  )

# Set reference categories for later regression models
adult_data <- adult_data %>%
  mutate(
    bmi_category = factor(
      bmi_category,
      levels = c("Normal weight", "Underweight", "Overweight", "Obesity")
    ),
    
    diabetes = factor(
      diabetes,
      levels = c("No", "Yes")
    ),
    
    smoking_status = factor(
      smoking_status,
      levels = c("Never", "Former", "Current")
    )
  )

# Check distributions
table(adult_data$bmi_category, useNA = "ifany")
table(adult_data$diabetes, useNA = "ifany")
table(adult_data$smoking_status, useNA = "ifany")

