library(haven)

# Find only the NHANES 2021-2023 "_L" files
files <- list.files(
  "~/Downloads",
  pattern = "_L\\.xpt$",
  full.names = TRUE
)

# Import them
nhanes <- lapply(files, read_xpt)

# Name the datasets
names(nhanes) <- tools::file_path_sans_ext(basename(files))

# Check
names(nhanes)
sapply(nhanes, function(x) "SEQN" %in% names(x))


data.frame(
  dataset = names(nhanes),
