    !is.na(adult_data$BPXOSY3)
)


# ---------------------------------------------------------
# Calculate Average Blood Pressure
# ---------------------------------------------------------

# Calculate each participant's average systolic and diastolic
# blood pressure using all available oscillometric readings.

adult_data <- adult_data %>%
  rowwise() %>%
  mutate(
    mean_sbp = mean(c_across(c(BPXOSY1, BPXOSY2, BPXOSY3)),
                    na.rm = TRUE),
    mean_dbp = mean(c_across(c(BPXODI1, BPXODI2, BPXODI3)),
                    na.rm = TRUE)
  ) %>%
  ungroup()

# Participants with no valid BP readings produce NaN.
# Convert these values to standard missing values (NA).

adult_data <- adult_data %>%
  mutate(
    mean_sbp = ifelse(is.nan(mean_sbp), NA, mean_sbp),
    mean_dbp = ifelse(is.nan(mean_dbp), NA, mean_dbp)
  )

# Examine the distributions of the calculated BP measures
summary(adult_data$mean_sbp)
summary(adult_data$mean_dbp)
