)
# ---------------------------------------------------------
# Merge NHANES Datasets
# ---------------------------------------------------------

# We use the demographic dataset (DEMO_L) as the base dataset
# because it contains the largest set of participants.
# The remaining NHANES components are merged using SEQN,
# the unique participant identifier shared across the datasets.
#
# A left join is used to retain all participants in DEMO_L,
# even if they are missing information from another component.

library(dplyr)

nhanes_merged <- nhanes$DEMO_L %>%
  left_join(nhanes$BMX_L,  by = "SEQN") %>%   # Body measurements
  left_join(nhanes$BPXO_L, by = "SEQN") %>%   # Measured blood pressure
  left_join(nhanes$BPQ_L,  by = "SEQN") %>%   # Blood pressure questionnaire
  left_join(nhanes$DIQ_L,  by = "SEQN") %>%   # Diabetes questionnaire
  left_join(nhanes$PAQ_L,  by = "SEQN") %>%   # Physical activity
  left_join(nhanes$SMQ_L,  by = "SEQN")       # Smoking

# Check the dimensions of the merged dataset
dim(nhanes_merged)

# Confirm that SEQN remains unique after merging
n_distinct(nhanes_merged$SEQN)

# ---------------------------------------------------------
# Verify the Merged Dataset
# ---------------------------------------------------------

# Check the number of participants and variables.
# The merged dataset contains 11,933 participants and 87 variables.
dim(nhanes_merged)

# Confirm that each participant still appears only once.
# The number of unique SEQN values should equal the number of rows.
n_distinct(nhanes_merged$SEQN)

# Result:
# 11,933 rows
# 87 variables
# 11,933 unique participants

