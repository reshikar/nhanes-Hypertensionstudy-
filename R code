# ---------------------------------------------------------
# Parsimonious Survey-Weighted Logistic Regression
# ---------------------------------------------------------

# Fit an adjusted model using major demographic and
# cardiometabolic factors associated with hypertension.
#
# A parsimonious model is used because the NHANES survey
# design provides limited degrees of freedom for variance
# estimation.

htn_model_reduced <- svyglm(
  hypertension ~ age_group +
    sex +
    bmi_category +
    diabetes,
  design = htn_design,
  family = quasibinomial()
)

summary(htn_model_reduced)


# ---------------------------------------------------------
# Adjusted Odds Ratios and 95% Confidence Intervals
# ---------------------------------------------------------

# Convert logistic regression coefficients from log-odds
# to adjusted odds ratios.

OR <- exp(coef(htn_model_reduced))
CI <- exp(confint(htn_model_reduced))

model_results <- data.frame(
  Variable = names(OR),
  Adjusted_OR = OR,
  CI_Lower = CI[, 1],
  CI_Upper = CI[, 2]
)

# Round only the numeric columns
model_results %>%
  mutate(
    Adjusted_OR = round(Adjusted_OR, 3),
    CI_Lower = round(CI_Lower, 3),
    CI_Upper = round(CI_Upper, 3)
  )

# ---------------------------------------------------------
# Adjusted Prevalence Ratios
# ---------------------------------------------------------

# Because hypertension is common in this population,
# prevalence ratios provide an interpretable measure of
# association for this cross-sectional analysis.

htn_pr_model <- svyglm(
  hypertension ~ age_group +
    sex +
    bmi_category +
    diabetes,
  design = htn_design,
  family = quasipoisson(link = "log")
)

# Convert coefficients to adjusted prevalence ratios
PR <- exp(coef(htn_pr_model))
CI <- exp(confint(htn_pr_model))

pr_results <- data.frame(
  Variable = names(PR),
  Adjusted_PR = PR,
  CI_Lower = CI[, 1],
  CI_Upper = CI[, 2]
)

pr_results %>%
  mutate(
    Adjusted_PR = round(Adjusted_PR, 3),
    CI_Lower = round(CI_Lower, 3),
    CI_Upper = round(CI_Upper, 3)
  )
