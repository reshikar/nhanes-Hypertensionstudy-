# ---------------------------------------------------------
# Select Variables for Hypertension Analysis
# ---------------------------------------------------------

# Create a smaller analytic dataset containing variables
# relevant to hypertension, demographic characteristics,
# cardiometabolic risk factors, health behaviors, and
# the NHANES complex survey design.

analysis_data <- nhanes_merged %>%
  select(
    # Participant identifier
    SEQN,
    
    # Demographics
    RIDAGEYR,       # Age in years
    RIAGENDR,       # Sex
    RIDRETH3,       # Race/ethnicity
    DMDEDUC2,       # Education
    INDFMPIR,       # Family income-to-poverty ratio
    
    # Body measurements
    BMXBMI,         # Body mass index (BMI)
    BMXWAIST,       # Waist circumference
    
    # Measured blood pressure
    BPXOSY1, BPXODI1,
    BPXOSY2, BPXODI2,
    BPXOSY3, BPXODI3,
    
    # Blood pressure questionnaire
    BPQ020,         # Ever told had high blood pressure
    BPQ030,         # Told on multiple occasions
    
    # Diabetes
    DIQ010,         # Doctor told participant they have diabetes
    
    # Physical activity
    PAD680,         # Sedentary time
    
    # Smoking
    SMQ020,         # Smoked at least 100 cigarettes in life
    SMQ040,         # Current smoking status
    
    # NHANES survey design variables
    WTMEC2YR,       # MEC examination weight
    SDMVSTRA,       # Survey stratum
    SDMVPSU         # Primary sampling unit
  )

# Check the new analytic dataset
